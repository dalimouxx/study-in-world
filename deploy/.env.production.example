# Variables de production — copier en deploy/.env sur le VPS, puis remplir. NE JAMAIS committer deploy/.env.
# Les secrets se génèrent sur le VPS avec : openssl rand -base64 48

# --- Ports locaux (127.0.0.1 seulement) : à changer s'ils sont déjà pris par un autre site du VPS ---
API_PORT=4100
WEB_PORT=3100

# --- Base de données ---
POSTGRES_USER=siw
POSTGRES_DB=siw
# Lettres et chiffres uniquement (il est repris dans une URL) : openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Sécurité des connexions ---
JWT_SECRET=
CANDIDATE_JWT_SECRET=
PARTNER_JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
CANDIDATE_JWT_ACCESS_TTL=30m
CANDIDATE_REFRESH_TTL_DAYS=90
PARTNER_JWT_ACCESS_TTL=30m
PARTNER_REFRESH_TTL_DAYS=90
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SWAGGER_ENABLED=false
DEFAULT_ORG_SLUG=study-in-world

# --- Premier compte Super Admin (créé au premier démarrage ; mot de passe à changer à la 1re connexion) ---
SEED_ADMIN_EMAIL=admin@studyinworld.net
# 10+ caractères, majuscule, minuscule, chiffre.
SEED_ADMIN_PASSWORD=
SEED_DEMO=false

# --- E-mails (relances, mots de passe oubliés). Vide : les e-mails sont seulement écrits dans les journaux ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Study in World <contact@studyinworld.net>"

# --- Facultatif ---
# Assistant IA : ANTHROPIC_API_KEY=
# Réveil extérieur des relances (inutile : l'API les lance elle-même chaque heure) : JOBS_SECRET=
