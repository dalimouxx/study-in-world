# ===== Study in World — variables d'environnement =====
# Copiez ce fichier en .env (racine) et adaptez. NE JAMAIS committer .env.

# --- Base de données ---
POSTGRES_USER=siw
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=siw
DATABASE_URL=postgresql://siw:change-me-postgres@localhost:5432/siw?schema=public

# --- API ---
NODE_ENV=development
PORT=4000
# Générer : openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Portail candidat (Phase 3, section 19) : optionnel — sans cette clé, retombe sur JWT_SECRET.
# Générer avec la même commande si vous voulez un secret distinct de celui des employés.
# CANDIDATE_JWT_SECRET=change-me-with-at-least-32-random-characters
CANDIDATE_JWT_ACCESS_TTL=30m
CANDIDATE_REFRESH_TTL_DAYS=90

# Portail partenaire (Phase 8) : même logique — secret distinct optionnel, sinon retombe sur JWT_SECRET.
# PARTNER_JWT_SECRET=change-me-with-at-least-32-random-characters
PARTNER_JWT_ACCESS_TTL=30m
PARTNER_REFRESH_TTL_DAYS=90

# Assistant IA (Phase 10) : optionnel — sans clé, le bouton renvoie une erreur claire côté interface.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
DEFAULT_ORG_SLUG=study-in-world
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SWAGGER_ENABLED=false

# --- E-mail (laisser SMTP_HOST vide en dev : les e-mails sont écrits dans les logs) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Study in World <contact@studyinworld.net>"

# --- Seed ---
SEED_ADMIN_EMAIL=admin@studyinworld.net
# 10+ caractères, majuscule, minuscule, chiffre. Changement exigé à la 1re connexion.
SEED_ADMIN_PASSWORD=ChangeMe-2026-Now
# Employés de test (@demo.local). Interdit en production.
SEED_DEMO=false

# --- Documents candidats (Phase 3) ---
# Dossier de stockage privé des fichiers uploadés (hors de tout dossier public). Par défaut : ./storage/documents
# STORAGE_DIR=/var/lib/siw/documents

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Évolutions futures (réservé, voir suggestions du README) ---
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# AI_API_KEY=
# WHATSAPP_API_KEY=
